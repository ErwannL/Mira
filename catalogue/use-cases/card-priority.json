{
  "id": "card-priority",
  "title": {
    "en": "Set card priority",
    "fr": "Priorité d'une carte"
  },
  "area": "cards",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "select",
      "target": {
        "role": "combobox",
        "name": {
          "en": "Priority",
          "fr": "Priorité"
        }
      },
      "value": "High"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Sauvegarder"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/boards/{{boardId}}/priorities",
      "body": {
        "title": "High",
        "color": "#dc2626"
      },
      "auth": true,
      "save": {
        "priorityId": "priority.id"
      },
      "expectStatus": [201]
    },
    {
      "method": "PATCH",
      "path": "/api/cards/{{cardId}}",
      "body": {
        "priority_id": "{{priorityId}}"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "{{cardTitle}}",
        "fr": "{{cardTitle}}"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
