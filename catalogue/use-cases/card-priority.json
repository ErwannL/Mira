{
  "id": "card-priority",
  "title": {
    "en": "Set card priority",
    "fr": "Priorité d'une carte"
  },
  "area": "cards",
  "requires": [
    "create-card"
  ],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/boards"
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        },
        "exact": true
      }
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        },
        "exact": true
      }
    },
    {
      "action": "select",
      "target": {
        "role": "combobox",
        "name": {
          "en": "Priority",
          "fr": "Priorité"
        }
      },
      "value": "high"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Enregistrer"
        }
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "status",
        "name": {
          "en": "Saved",
          "fr": "Enregistré"
        }
      }
    }
  ],
  "api": [
    {
      "method": "PATCH",
      "path": "/api/cards/{{cardId}}",
      "body": {
        "priority": "high"
      },
      "auth": true
    }
  ],
  "success": {
    "ui": {
      "role": "status",
      "name": {
        "en": "Saved",
        "fr": "Enregistré"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
