{
  "id": "create-card",
  "title": {
    "en": "Create a card",
    "fr": "Créer une carte"
  },
  "area": "cards",
  "requires": ["create-board"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "+ Add a card",
          "fr": "+ Ajouter une carte"
        },
        "exact": true
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Title",
          "fr": "Titre"
        },
        "exact": true
      },
      "value": "{{cardTitle}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Add",
          "fr": "Ajouter"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/lists?board_id={{boardId}}",
      "auth": true,
      "save": {
        "listId": "lists.0.id",
        "doneListId": "lists.2.id"
      }
    },
    {
      "method": "POST",
      "path": "/api/cards",
      "body": {
        "title": "{{cardTitle}}",
        "list_id": "{{listId}}"
      },
      "auth": true,
      "save": {
        "cardId": "card.id"
      },
      "expectStatus": [201]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "{{cardTitle}}",
        "fr": "{{cardTitle}}"
      }
    },
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 2,
    "words": 120
  }
}
