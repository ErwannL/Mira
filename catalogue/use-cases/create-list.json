{
  "id": "create-list",
  "title": {
    "en": "Create a list",
    "fr": "Créer une liste"
  },
  "area": "boards",
  "requires": ["create-board"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "+ Add a list",
          "fr": "+ Ajouter une liste"
        },
        "exact": true
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "List name",
          "fr": "Nom de la liste"
        }
      },
      "value": "Backlog"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Add the new list",
          "fr": "Ajouter la nouvelle liste"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Backlog",
        "fr": "Backlog"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/lists",
      "body": {
        "title": "Backlog",
        "board_id": "{{boardId}}"
      },
      "auth": true,
      "save": {
        "backlogListId": "list.id"
      },
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 2,
    "words": 120
  }
}
