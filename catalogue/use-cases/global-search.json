{
  "id": "global-search",
  "title": {
    "en": "Global search",
    "fr": "Recherche globale"
  },
  "area": "navigation",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Search",
          "fr": "Rechercher"
        },
        "exact": true
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Search a card across all your boards",
          "fr": "Rechercher une carte dans tous vos boards"
        }
      },
      "value": "{{cardTitle}}"
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/search?q={{cardTitle}}",
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "{{cardTitle}}",
        "fr": "{{cardTitle}}"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 1,
    "clicks": 1,
    "words": 80
  }
}
