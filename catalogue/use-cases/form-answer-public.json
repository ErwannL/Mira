{
  "id": "form-answer-public",
  "title": {
    "en": "Answer a public form",
    "fr": "Répondre à un formulaire public"
  },
  "area": "forms",
  "requires": ["form-create"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/forms/{{formToken}}"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Your name?",
          "fr": "Your name?"
        }
      },
      "value": "Dominique"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Send my request",
          "fr": "Envoyer ma demande"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Thank you",
        "fr": "Merci"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/forms/{{formToken}}/submit",
      "body": {
        "values": {
          "name": "Dominique"
        }
      },
      "auth": false,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 1,
    "clicks": 1,
    "words": 60
  }
}
