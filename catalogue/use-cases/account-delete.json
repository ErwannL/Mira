{
  "id": "account-delete",
  "title": {
    "en": "Delete my account",
    "fr": "Supprimer mon compte"
  },
  "area": "settings",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/settings?tab=privacy"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Permanently delete my account",
          "fr": "Supprimer définitivement mon compte"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "password",
        "name": {
          "en": "To confirm, enter your password",
          "fr": "Pour confirmer, saisissez votre mot de passe"
        }
      },
      "value": "{{password}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Confirm deletion",
          "fr": "Confirmer la suppression"
        }
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "link",
        "name": {
          "en": "Try the beta",
          "fr": "Essayer la bêta"
        }
      }
    }
  ],
  "api": [
    {
      "method": "DELETE",
      "path": "/api/user/me",
      "body": {
        "password": "{{password}}"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "ui": {
      "role": "link",
      "name": {
        "en": "Try the beta",
        "fr": "Essayer la bêta"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 2,
    "words": 80
  }
}
