{
  "id": "automation-rule",
  "title": {
    "en": "Automation rule",
    "fr": "Règle d'automatisation"
  },
  "area": "automation",
  "requires": ["create-board"],
  "planGate": "free",
  "minutes": 3,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Rules",
          "fr": "Règles"
        },
        "exact": true
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "New rule",
          "fr": "Nouvelle règle"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Rule name",
          "fr": "Nom de la règle"
        }
      },
      "value": "Light new cards"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Enregistrer"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Light new cards",
        "fr": "Light new cards"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/boards/{{boardId}}/rules",
      "body": {
        "name": "Light new cards",
        "trigger": {
          "type": "card_created"
        },
        "actions": [
          {
            "type": "complexity.set",
            "complexity": "light"
          }
        ]
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 4,
    "words": 150
  }
}
