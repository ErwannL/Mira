{
  "id": "comment",
  "title": {
    "en": "Comment on a card",
    "fr": "Commenter une carte"
  },
  "area": "collaboration",
  "requires": [
    "create-card"
  ],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/boards"
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        },
        "exact": true
      }
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        },
        "exact": true
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Comment",
          "fr": "Commentaire"
        }
      },
      "value": "Looks good to me"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Post comment",
          "fr": "Publier"
        }
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "status",
        "name": {
          "en": "Comment posted",
          "fr": "Commentaire publié"
        }
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/cards/{{cardId}}/comments",
      "body": {
        "text": "Looks good to me"
      },
      "auth": true,
      "expectStatus": [
        201
      ]
    }
  ],
  "success": {
    "ui": {
      "role": "status",
      "name": {
        "en": "Comment posted",
        "fr": "Commentaire publié"
      }
    },
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
