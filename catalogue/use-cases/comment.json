{
  "id": "comment",
  "title": {
    "en": "Comment on a card",
    "fr": "Commenter une carte"
  },
  "area": "collaboration",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "tab",
        "name": {
          "en": "Activity",
          "fr": "Activité"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Add a comment",
          "fr": "Ajouter un commentaire"
        }
      },
      "value": "Looks good to me"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Add a comment",
          "fr": "Ajouter un commentaire"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Looks good to me",
        "fr": "Looks good to me"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/cards/{{cardId}}/comments",
      "body": {
        "content": "Looks good to me"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
