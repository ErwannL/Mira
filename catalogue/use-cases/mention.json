{
  "id": "mention",
  "title": {
    "en": "Mention a teammate",
    "fr": "Mentionner un coéquipier"
  },
  "area": "collaboration",
  "requires": ["comment", "invite-member"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "tab",
        "name": {
          "en": "Activity",
          "fr": "Activité"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Add a comment",
          "fr": "Ajouter un commentaire"
        }
      },
      "value": "@{{inviteEmail}} can you check?"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Add a comment",
          "fr": "Ajouter un commentaire"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "@{{inviteEmail}} can you check?",
        "fr": "@{{inviteEmail}} can you check?"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/cards/{{cardId}}/comments",
      "body": {
        "content": "@{{inviteEmail}} can you check?"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
