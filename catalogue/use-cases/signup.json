{
  "id": "signup",
  "title": {
    "en": "Sign up",
    "fr": "Inscription"
  },
  "area": "acquisition",
  "requires": ["landing"],
  "planGate": "free",
  "minutes": 3,
  "mistakes": ["typoEmail", "weakPassword", "forgetTerms"],
  "ui": [
    {
      "action": "goto",
      "path": "/"
    },
    {
      "action": "click",
      "target": {
        "role": "link",
        "name": {
          "en": "Try the beta",
          "fr": "Essayer la bêta"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Username",
          "fr": "Pseudo"
        }
      },
      "value": "{{username}}"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Email",
          "fr": "Email"
        },
        "exact": true
      },
      "value": "{{email}}"
    },
    {
      "action": "fill",
      "target": {
        "role": "password",
        "name": {
          "en": "Password",
          "fr": "Mot de passe"
        }
      },
      "value": "{{password}}"
    },
    {
      "action": "check",
      "target": {
        "role": "checkbox",
        "name": {
          "en": "I accept the terms of use",
          "fr": "J'accepte les conditions d'utilisation"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Sign up",
          "fr": "S'inscrire"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Account created",
        "fr": "Compte créé"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/auth/register",
      "body": {
        "email": "{{email}}",
        "password": "{{password}}",
        "username": "{{username}}",
        "acceptedTerms": true
      },
      "auth": false,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 2,
    "words": 120
  }
}
