{
  "id": "notes-reminder",
  "title": {
    "en": "Note with a reminder",
    "fr": "Note avec rappel"
  },
  "area": "planning",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Notes and reminders",
          "fr": "Notes et rappels"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "New note",
          "fr": "Nouvelle note"
        }
      },
      "value": "Order flour"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Enregistrer"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Order flour",
        "fr": "Order flour"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/notes",
      "body": {
        "content": "Order flour",
        "remind_at": "2030-01-15T09:00:00Z"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 80
  }
}
