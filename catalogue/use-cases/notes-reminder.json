{
  "id": "notes-reminder",
  "title": {
    "en": "Note with a reminder",
    "fr": "Note avec rappel"
  },
  "area": "planning",
  "requires": [
    "login"
  ],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/notes"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Note",
          "fr": "Note"
        }
      },
      "value": "Order flour"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Remind me on",
          "fr": "Me le rappeler le"
        }
      },
      "value": "2030-01-15 09:00"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save note",
          "fr": "Enregistrer la note"
        }
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "status",
        "name": {
          "en": "Reminder set",
          "fr": "Rappel programmé"
        }
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/notes",
      "body": {
        "text": "Order flour",
        "remindAt": "2030-01-15T09:00:00Z"
      },
      "auth": true,
      "expectStatus": [
        201
      ]
    }
  ],
  "success": {
    "ui": {
      "role": "status",
      "name": {
        "en": "Reminder set",
        "fr": "Rappel programmé"
      }
    },
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 80
  }
}
