{
  "id": "invite-without-account",
  "title": {
    "en": "Invite someone without an account",
    "fr": "Inviter sans compte"
  },
  "area": "collaboration",
  "requires": ["create-board"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Collaborators",
          "fr": "Collaborateurs"
        },
        "exact": true
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Invite a collaborator",
          "fr": "Inviter un collaborateur"
        }
      },
      "value": "{{strangerEmail}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Invite",
          "fr": "Inviter"
        },
        "exact": true
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Invitation created",
        "fr": "Invitation créée"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/boards/{{boardId}}/members",
      "body": {
        "email": "{{strangerEmail}}"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 1,
    "clicks": 3,
    "words": 100
  }
}
