{
  "id": "data-export",
  "title": {
    "en": "Export my data",
    "fr": "Exporter mes données"
  },
  "area": "settings",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/settings?tab=privacy"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Download my data (JSON)",
          "fr": "Télécharger mes données (JSON)"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Export downloaded.",
        "fr": "Export téléchargé."
      }
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/user/me/export",
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 80
  }
}
