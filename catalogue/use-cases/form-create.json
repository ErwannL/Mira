{
  "id": "form-create",
  "title": {
    "en": "Create a form",
    "fr": "Créer un formulaire"
  },
  "area": "forms",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 3,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Forms",
          "fr": "Formulaires"
        },
        "exact": true
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "+ Create New Form",
          "fr": "+ Créer un nouveau formulaire"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Title",
          "fr": "Titre"
        },
        "exact": true
      },
      "value": "Registration"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Enregistrer"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "Copy public link",
          "fr": "Copier le lien public"
        }
      }
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/lists?board_id={{boardId}}",
      "auth": true,
      "save": {
        "listId": "lists.0.id",
        "doneListId": "lists.2.id"
      }
    },
    {
      "method": "POST",
      "path": "/api/boards/{{boardId}}/labels",
      "body": {
        "title": "Form",
        "color": "#2563eb"
      },
      "auth": true,
      "save": {
        "labelId": "label.id"
      },
      "expectStatus": [201]
    },
    {
      "method": "POST",
      "path": "/api/boards/{{boardId}}/forms",
      "body": {
        "title": "Registration",
        "config": {
          "target_list_id": "{{listId}}",
          "label_ids": ["{{labelId}}"],
          "fields": [
            {
              "id": "name",
              "type": "text",
              "label": "Your name?",
              "required": true
            }
          ],
          "title_field": "name"
        }
      },
      "auth": true,
      "save": {
        "formToken": "form.public_token"
      },
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 100
  }
}
