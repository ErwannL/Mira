{
  "id": "billing-checkout",
  "title": {
    "en": "Checkout (test mode)",
    "fr": "Paiement (mode test)"
  },
  "area": "billing",
  "requires": ["billing-view-plans"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/billing"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Choose {{planName}}",
          "fr": "Choisir {{planName}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/billing/me/checkout",
      "body": {
        "planKey": "{{planKey}}",
        "interval": "month"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 0,
    "clicks": 1,
    "words": 150
  }
}
