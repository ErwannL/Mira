{
  "id": "settings-language",
  "title": {
    "en": "Change language",
    "fr": "Changer de langue"
  },
  "area": "settings",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/profile"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Edit",
          "fr": "Modifier"
        },
        "exact": true
      }
    },
    {
      "action": "select",
      "target": {
        "role": "combobox",
        "name": {
          "en": "Preferred language",
          "fr": "Langue préférée"
        }
      },
      "value": "{{locale}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Sauvegarder"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "Search",
          "fr": "Rechercher"
        },
        "exact": true
      }
    }
  ],
  "api": [
    {
      "method": "PATCH",
      "path": "/api/user/me/preferences",
      "body": {
        "language": "{{locale}}"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 80
  }
}
