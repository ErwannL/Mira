{
  "id": "create-board",
  "title": {
    "en": "Create a board",
    "fr": "Créer un tableau"
  },
  "area": "boards",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Board name",
          "fr": "Nom du board"
        }
      },
      "value": "{{boardName}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Create board",
          "fr": "Créer le board"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "+ Add a card",
          "fr": "+ Ajouter une carte"
        },
        "exact": true
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/boards",
      "body": {
        "title": "{{boardName}}",
        "default_table": true
      },
      "auth": true,
      "save": {
        "boardId": "board.id"
      },
      "expectStatus": [201]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "+ Add a card",
        "fr": "+ Ajouter une carte"
      },
      "exact": true
    },
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 1,
    "clicks": 1,
    "words": 80
  }
}
