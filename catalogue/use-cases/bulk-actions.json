{
  "id": "bulk-actions",
  "title": {
    "en": "Bulk actions",
    "fr": "Actions groupées"
  },
  "area": "cards",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Select",
          "fr": "Sélectionner"
        },
        "exact": true
      }
    },
    {
      "action": "check",
      "target": {
        "role": "checkbox",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "1 card selected",
        "fr": "1 carte sélectionnée"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/cards/bulk",
      "body": {
        "card_ids": ["{{cardId}}"],
        "operations": [
          {
            "type": "complexity.set",
            "complexity": "high"
          }
        ]
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 4,
    "words": 120
  }
}
