{
  "id": "edit-card",
  "title": {
    "en": "Edit a card",
    "fr": "Modifier une carte"
  },
  "area": "cards",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Description",
          "fr": "Description"
        }
      },
      "value": "Details written by {{personaName}}"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Save",
          "fr": "Sauvegarder"
        },
        "exact": true
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "PUT",
      "path": "/api/cards/{{cardId}}",
      "body": {
        "title": "{{cardTitle}}",
        "description": "Details written by {{personaName}}"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "{{cardTitle}}",
        "fr": "{{cardTitle}}"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
