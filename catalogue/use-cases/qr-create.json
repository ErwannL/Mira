{
  "id": "qr-create",
  "title": {
    "en": "Create a QR code",
    "fr": "Créer un QR code"
  },
  "area": "sharing",
  "requires": ["login"],
  "planGate": "qrCodes",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/qr"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Code name",
          "fr": "Nom du code"
        }
      },
      "value": "Poster"
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Destination",
          "fr": "Destination"
        }
      },
      "value": "https://example.org"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Create the code",
          "fr": "Créer le code"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Poster",
        "fr": "Poster"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/qr-codes",
      "body": {
        "label": "Poster",
        "targetUrl": "https://example.org"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 1,
    "clicks": 1,
    "words": 60
  }
}
