{
  "id": "settings-theme",
  "title": {
    "en": "Change theme",
    "fr": "Changer de thème"
  },
  "area": "settings",
  "requires": ["login"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/settings?tab=preferences"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Select the dark theme",
          "fr": "sélectionner le thème sombre"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Theme saved!",
        "fr": "Thème enregistré !"
      }
    }
  ],
  "api": [
    {
      "method": "PATCH",
      "path": "/api/user/me/preferences",
      "body": {
        "theme": "dark"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 2,
    "clicks": 1,
    "words": 80
  }
}
