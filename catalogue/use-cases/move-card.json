{
  "id": "move-card",
  "title": {
    "en": "Move a card (drag and drop)",
    "fr": "Déplacer une carte (glisser-déposer)"
  },
  "area": "cards",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 1,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "drag",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      },
      "to": {
        "role": "heading",
        "name": {
          "en": "done",
          "fr": "terminé"
        }
      }
    },
    {
      "action": "expect",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    }
  ],
  "api": [
    {
      "method": "GET",
      "path": "/api/lists?board_id={{boardId}}",
      "auth": true,
      "save": {
        "listId": "lists.0.id",
        "doneListId": "lists.2.id"
      }
    },
    {
      "method": "PUT",
      "path": "/api/cards/{{cardId}}",
      "body": {
        "list_id": "{{doneListId}}"
      },
      "auth": true,
      "expectStatus": [200]
    }
  ],
  "success": {
    "ui": {
      "role": "button",
      "name": {
        "en": "{{cardTitle}}",
        "fr": "{{cardTitle}}"
      }
    },
    "apiStatus": 200
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 2,
    "words": 120
  }
}
