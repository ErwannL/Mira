{
  "id": "checklist",
  "title": {
    "en": "Checklist",
    "fr": "Liste de contrôle"
  },
  "area": "cards",
  "requires": ["create-card"],
  "planGate": "free",
  "minutes": 2,
  "ui": [
    {
      "action": "goto",
      "path": "/dashboard"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{boardName}}",
          "fr": "{{boardName}}"
        }
      }
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "{{cardTitle}}",
          "fr": "{{cardTitle}}"
        }
      }
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": {
          "en": "Add item",
          "fr": "Ajouter un élément"
        },
        "exact": true
      },
      "value": "Call the supplier"
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": {
          "en": "Add check",
          "fr": "Ajouter un check"
        }
      }
    },
    {
      "action": "expectText",
      "text": {
        "en": "Call the supplier",
        "fr": "Call the supplier"
      }
    }
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/cards/{{cardId}}/checklist/items",
      "body": {
        "title": "Call the supplier"
      },
      "auth": true,
      "expectStatus": [201]
    }
  ],
  "success": {
    "apiStatus": 201
  },
  "frictionHints": {
    "fields": 3,
    "clicks": 3,
    "words": 100
  }
}
